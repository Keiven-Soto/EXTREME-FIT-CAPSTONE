{
  "name": "server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:node": "node ./node_modules/jest/bin/jest.js --runInBand",
    "test:debug": "node ./node_modules/jest/bin/jest.js --runInBand --detectOpenHandles",
    "test:cart": "node ./node_modules/jest/bin/jest.js --runInBand test/backend_tests/cart.test.js --verbose"
  },
  "dependencies": {
    "@clerk/express": "^1.7.37",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "svix": "^1.76.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "jest": "^29.6.1",
    "supertest": "^6.3.3"
  }
  ,
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/test/setupRequireMocks.js"],
    "setupFilesAfterEnv": ["<rootDir>/test/setupTests.js"],
    "testMatch": ["<rootDir>/test/backend_tests/**/*.test.js"]
  }
}
