{
  "name": "server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:node": "node ./node_modules/jest/bin/jest.js --runInBand",
    "test:debug": "node ./node_modules/jest/bin/jest.js --runInBand --detectOpenHandles",
    "test:cart": "node ./node_modules/jest/bin/jest.js --runInBand test/backend_tests/cart.test.js --verbose",
    "test:load-ramp": "artillery run test/LOAD_TESTING/load-ramp.yml --output test/LOAD_TESTING/results/load-ramp-latest.json && node test/LOAD_TESTING/parse-results.js test/LOAD_TESTING/results/load-ramp-latest.json",
    "test:spike": "artillery run test/LOAD_TESTING/spike.yml --output test/LOAD_TESTING/results/spike-latest.json && node test/LOAD_TESTING/parse-results.js test/LOAD_TESTING/results/spike-latest.json",
    "test:pool-stress": "artillery run test/LOAD_TESTING/pool-stress.yml --output test/LOAD_TESTING/results/pool-stress-latest.json && node test/LOAD_TESTING/parse-results.js test/LOAD_TESTING/results/pool-stress-latest.json",
    "test:soak": "artillery run test/LOAD_TESTING/soak.yml --output test/LOAD_TESTING/results/soak-latest.json && node test/LOAD_TESTING/parse-results.js test/LOAD_TESTING/results/soak-latest.json",
    "test:users": "jest test/backend_test/users.test.js --verbose",
    "test:products": "jest test/backend_test/products.test.js --verbose",
    "test:orders": "jest test/backend_test/order.test.js --verbose",
    "test:categories": "jest test/backend_test/categories.test.js --verbose",
    "test:wishlist": "jest test/backend_test/wishlist.test.js --verbose",
    "test:all": "jest test/backend_test/ --verbose",
    "test:all:coverage": "jest test/backend_test/ --verbose --coverage"
  },
  "dependencies": {
    "@clerk/express": "^1.7.37",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "stripe": "^19.3.0",
    "svix": "^1.76.1"
  },
  "devDependencies": {
    "artillery": "^2.0.26",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/setupRequireMocks.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setupTests.js"
    ],
    "testMatch": [
      "<rootDir>/test/backend_tests/**/*.test.js"
    ]
  }
}
