{
  "name": "server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:load-ramp": "artillery run test/LOAD_TESTING/load-ramp.yml --output test/LOAD_TESTING/results/load-ramp-latest.json && node test/LOAD_TESTING/parse-results.js test/LOAD_TESTING/results/load-ramp-latest.json",
    "test:spike": "artillery run test/LOAD_TESTING/spike.yml --output test/LOAD_TESTING/results/spike-latest.json && node test/LOAD_TESTING/parse-results.js test/LOAD_TESTING/results/spike-latest.json",
    "test:pool-stress": "artillery run test/LOAD_TESTING/pool-stress.yml --output test/LOAD_TESTING/results/pool-stress-latest.json && node test/LOAD_TESTING/parse-results.js test/LOAD_TESTING/results/pool-stress-latest.json",
    "test:soak": "artillery run test/LOAD_TESTING/soak.yml --output test/LOAD_TESTING/results/soak-latest.json && node test/LOAD_TESTING/parse-results.js test/LOAD_TESTING/results/soak-latest.json"
  },
  "dependencies": {
    "@clerk/express": "^1.7.37",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "svix": "^1.76.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
